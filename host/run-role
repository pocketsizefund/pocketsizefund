#!/usr/bin/env bash
# Builds and runs one role's work under the `FUND_PROFILE` secrets, the same on any box: `devenv shell -- host/run-role
# <role> [job] [hours]`, a researcher's job being `jobs/<job>.sh` killed after `hours` (default 6). Run inside devenv;
# `run-host` is the EC2 wrapper.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

role="${1:-}"
case "$role" in
  archiver) binary=archive_nightly ;;
  trader) binary=trader ;;
  researcher) binary="" ;;
  *)
    echo "Error: the role is \"$role\", not archiver, trader or researcher"
    exit 1
    ;;
esac

if [[ -z "${FUND_PROFILE:-}" ]]; then
  echo "Error: FUND_PROFILE is not set; it names the profile whose secrets the $role reads"
  exit 1
fi

# A job never runs on an earlier build; `kill -0` polls its PID, where `pgrep -f` would match the poller itself.
if [[ "$role" == researcher ]]; then
  job="${2:-}"
  hours="${3:-6}"
  if [[ ! "$job" =~ ^[a-z0-9_]+$ ]]; then
    echo "Error: the job is \"$job\", not a name of lowercase letters, digits and underscores"
    exit 1
  fi
  if [[ ! "$hours" =~ ^([1-9]|1[0-9]|2[0-4])$ ]]; then
    echo "Error: the job's hours are \"$hours\", not a whole number from 1 to 24"
    exit 1
  fi
  if [[ ! -f "jobs/$job.sh" ]]; then
    echo "Error: there is no jobs/$job.sh"
    exit 1
  fi
  cargo build -q --release --workspace
  # Job control gives the job its own process group, so a timeout reaches every process it started.
  set -m
  secretspec run --profile "$FUND_PROFILE" --reason "Running the researcher job $job" -- \
    env PATH="$PWD/target/release:$PATH" bash "jobs/$job.sh" &
  pid=$!
  deadline=$((SECONDS + hours * 3600))
  while kill -0 "$pid" 2>/dev/null; do
    if [[ "$SECONDS" -ge "$deadline" ]]; then
      kill -TERM -- "-$pid" 2>/dev/null || true
      sleep 60
      kill -KILL -- "-$pid" 2>/dev/null || true
      wait "$pid" || true
      echo "Job $job timed out after $hours h"
      exit 124
    fi
    sleep 30
  done
  status=0
  wait "$pid" || status=$?
  echo "Job $job at $(git rev-parse --short HEAD) exited $status"
  exit "$status"
fi

if ! cargo build -q --release --bin "$binary"; then
  if [[ ! -x "target/release/$binary" ]]; then
    echo "Error: building $binary at $(git rev-parse --short HEAD) failed and no earlier build exists"
    exit 1
  fi
  echo "Error: building $binary at $(git rev-parse --short HEAD) failed; running the previous build"
fi

exec secretspec run --profile "$FUND_PROFILE" --reason "Running the $role role" -- "target/release/$binary"
